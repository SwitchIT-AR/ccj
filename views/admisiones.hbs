<section>
  <div class="contenedor">
    <h3>Admisiones</h3>
    <p>
      La elección de un colegio para nuestros hijos es una decisión muy
      importante. <br />
      En nuestra institución este proceso lo realizamos de manera
      personalizada. <br />
      El proceso consta de tres instancias:
    </p>
    <p>
      <b> 1º Entrevista: </b>
      Orientada a conocer el colegio y nuestra propuesta educativa y
      pedagógica.
    </p>
    <p>
      <b> 2º Entrevista: </b>
      Junto al Gabinete conocer al alumno entrante.
    </p>
    <p>
      <b> 3º Entrevista: </b>
      Inscripción administrativa de alumno.
    </p>
    <hr />
    <h2 class="h1">Registro</h2>
    <h5 class="py-3 d-block">
      A continuación completar estos datos y nos comunicaremos con ustedes:
    </h5>
    <form id="form-admisiones" class="p-4" style="background: #ddd; border-radius: 20px">
      <div class="form-row">
        <div class="form-group col-md-12">
          <label for="alumno">Nombre y apellido del alumno entrante</label>
          <input type="text" class="form-control" id="alumno" placeholder="" />
        </div>
        <div class="form-group col-md-8">
          <label for="nivel">Nivel educativo:</label>
          <input type="text" class="form-control" id="nivel" placeholder="" />
        </div>
        <div class="form-group col-md-4">
          <label for="edad">Edad:</label>
          <input type="number" class="form-control" id="edad" min="1" max="18" placeholder="" />
        </div>
        <div class="form-group col-md-12">
          <label for="institucion">Institución de la que proviene:</label>
          <input type="text" class="form-control" id="institucion" placeholder="" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group col-md-6">
          <label for="noPadre">Nombre del Responsable I</label>
          <input type="text" class="form-control" id="noPadre" placeholder="" />
        </div>
        <div class="form-group col-md-6">
          <label for="apPadre">Apellido del Responsable I</label>
          <input type="text" class="form-control" id="apPadre" placeholder="" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group col-md-6">
          <label for="noMadre">Nombre de la Responsable II</label>
          <input type="text" class="form-control" id="noMadre" placeholder="" />
        </div>
        <div class="form-group col-md-6">
          <label for="apMadre">Apellido de la Responsable II</label>
          <input type="text" class="form-control" id="apMadre" placeholder="" />
        </div>
      </div>
      <div class="form-group">
        <label for="direccion">Dirección:</label>
        <input type="text" class="form-control" id="direccion" placeholder="" />
      </div>
      <div class="form-group">
        <label for="tel">Teléfono:</label>
        <input type="text" class="form-control" id="tel" placeholder="" />
      </div>
      <div class="form-group">
        <label for="inputEmail">Mail:</label>
        <input type="email" class="form-control" id="inputEmail" placeholder="" />
      </div>
      <div class="form-group">
        <label for="porqueGartenstadt">Por qué eligieron esta institución:</label>
        <textarea class="form-control" id="porqueGartenstadt" rows="3"></textarea>
      </div>
      <div id="loader" style="text-align:center; padding: 2rem; display:none">
  <div class="spinner-border text-white" role="status">
    <span class="sr-only">Cargando...</span>
  </div>
</div>
      <input type="button" id="registerButton" value="ENVIAR" class="btn btn-block btn-primary mt-4 mb-2" onclick="registrar()" />
      <script>
        function registrar() {
          const loader = document.getElementById("loader");
          const regButton = document.getElementById("registerButton");
          loader.style.display = "block";
          regButton.style.display = 'none';
          const data = {
            nombreApellido: document.getElementById("alumno").value,
            nivelEducativo: document.getElementById("nivel").value,
            edad: document.getElementById("edad").value,
            institucionProveniente:
              document.getElementById("institucion").value,
            nombrePadre: document.getElementById("noPadre").value,
            apellidoPadre: document.getElementById("apPadre").value,
            nombreMadre: document.getElementById("noMadre").value,
            apellidoMadre: document.getElementById("apMadre").value,
            direccion: document.getElementById("direccion").value,
            telefono: document.getElementById("tel").value,
            mail: document.getElementById("inputEmail").value,
            mensaje: document.getElementById("porqueGartenstadt").value,
            como: "Sitio Web",
            cual: "",
            red: "Sitio Web Gartenstadt",
          };

          var urlCompleta =
            "https://colegiociudadjardin.edu.ar/landing/matricula";
          var request = $.ajax({
            url: urlCompleta,
            type: "POST",
            dataType: "json",
            data,
          });

          request.done(function (response) {
            document.getElementById("form-admisiones").reset();
            loader.style.display = "none";
            regButton.style.display = 'block';
            $("#modalExito").modal("show");
            fbq("track", "Registro");
          });

          request.fail(function (jqXHR, textStatus) {
            document.getElementById("form-admisiones").reset();
            loader.style.display = "none";
            regButton.style.display = 'block';
            $("#modalFail").modal("show");
            fbq("track", "RegistroFallido");
          });
        }

        // SCRIPT AUTOLUNCH YOUTUBE MODAL
         // Todo adentro de DOMContentLoaded para asegurar que #modalVideo ya existe
  document.addEventListener('DOMContentLoaded', function () {
    var modalEl = document.getElementById('modalVideo');
    if (!modalEl) {
      console.warn('No se encontró #modalVideo en el DOM.');
      return;
    }

    var iframe = document.getElementById('videoIframe');
    var backdrop = null;

    function stopYouTube() {
      try {
        // Requiere enablejsapi=1 en el src
        iframe.contentWindow.postMessage(
          JSON.stringify({ event: 'command', func: 'stopVideo', args: [] }),
          '*'
        );
      } catch (e) {
        // Fallback duro si algo falla
        iframe.src = iframe.src;
      }
    }

    function openModal() {
  // crear backdrop estilo BS4
  backdrop = document.createElement('div');
  backdrop.className = 'modal-backdrop fade';
  document.body.appendChild(backdrop);

  // mostrar backdrop y modal
  requestAnimationFrame(function () {
    backdrop.classList.add('show');
    modalEl.style.display = 'block';
    modalEl.removeAttribute('aria-hidden');
    modalEl.classList.add('show');
    document.body.classList.add('modal-open');
    document.body.style.overflow = 'hidden';
  });

  // cerrar si se hace click fuera del modal (en el backdrop)
  backdrop.addEventListener('click', function (e) {
    // aseguramos que el click sea directamente en el backdrop
    if (e.target === backdrop) {
      closeModal();
    }
  });
}

    function closeModal() {
      if (backdrop) backdrop.classList.remove('show');
      modalEl.classList.remove('show');
      document.body.classList.remove('modal-open');
      document.body.style.overflow = '';

      stopYouTube();

      setTimeout(function () {
        modalEl.style.display = 'none';
        modalEl.setAttribute('aria-hidden', 'true');
        if (backdrop && backdrop.parentNode) {
          backdrop.parentNode.removeChild(backdrop);
          backdrop = null;
        }
      }, 150); // tiempo similar al fade de BS4
    }

    // cerrar con botones
    [].forEach.call(
      modalEl.querySelectorAll('.js-modal-close'),
      function (btn) { btn.addEventListener('click', closeModal); }
    );

    // cerrar con ESC
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });

    // abrir automáticamente al cargar el DOM
    openModal();
  });
      </script>
    </form>
