<section id="landing" data-ruta="{{textos.ruta}}">
  <div class="landing-img"
    style="background-image: linear-gradient(rgba(0,0,0,.15), rgba(0,0,0,.15)),url({{#if textos.imageTop}}{{textos.imageTop}}{{else}}/img/nuestro-colegio/top.jpg{{/if}});{{#if textos.imageTopPos}} background-position: center {{textos.imageTopPos}}%;{{/if}}">
    <h2 class="landing-title">{{textos.titulo}}</h2>
    <h5 class="landing-subtitle">{{textos.saludo}}</h5>
  </div>
</section>

<section>
  <div class="contenedor">
    <h3 class="text-center">{{{textos.subTitulo1}}}</h3>
    <p>
      {{{textos.parrafo1}}}
    </p>
  </div>
</section>

<section class="c-amarillo text-white">
  <div class="contenedor pb-3">
    <h3 class="text-center">
      {{textos.subTitulo2}}
    </h3>
    <p>
      {{{textos.parrafo2}}}
    </p>
    <div class="row justify-content-md-center">
      <div class="col-5">
        <ul class="py-5">

          <h5 class="h3 d-inline">

            {{{textos.auxText1}}}

          </h5>


          <br>

          <h5 class="h3 d-inline">

            {{{textos.auxText2}}}

          </h5>


        </ul>
      </div>
      <div class="col-5">
        <ul class="py-5">

          <h5 class="h3 d-inline">

            {{{textos.auxText3}}}

          </h5>


          <br>

          <h5 class="h3 d-inline">

            {{{textos.auxText4}}}

          </h5>

        </ul>
      </div>
    </div>
  </div>
</section>

<section class="c-rojo text-white">
  <div class="contenedor">
    <h3 class="text-center">{{textos.subTitulo3}}</h3>
    <p>

      {{{textos.parrafo3}}}
    </p>
  </div>
</section>

<section id="title-cards" class="c-celeste text-white">
  <div class="mx-4 p-5">
    <h3 class="text-center mb-5">{{{textos.subTitulo4}}}</h3>
    {{!-- Auditoría 21/09: cada tarjeta se dibuja SÓLO si el documento trae su título, y la
          foto sólo si trae cardImageN. Antes las cuatro se renderizaban siempre: una página
          con 3 tarjetas (como /lideres o /escuela-para-familias) dejaba una tarjeta blanca
          vacía al final, y una sin fotos publicaba cuatro placeholders de "FOTO PENDIENTE".
          Las 6 páginas que ya estaban en producción traen los 4 cardTitulo cargados, así que
          no cambian. --}}
    <div class="card-deck mb-5 text-dark">
      {{#if textos.cardTitulo1}}
      <div class="card">
        {{#if textos.cardImage1}}<img src="{{textos.cardImage1}}" class="card-img-top" alt="{{textos.cardTitulo1}}"{{#if textos.cardImage1Pos}} style="object-position: center {{textos.cardImage1Pos}}%"{{/if}}>{{/if}}
        <div class="card-body pb-2">
          <h5 class="card-title">
            {{textos.cardTitulo1}}
          </h5>
          <p>
            {{textos.cardTexto1}}
          </p>
        </div>
        <div class="card-footer text-center border-0 bg-transparent pt-0">
          <a href="#" class="btn btn-dark" hidden>Ver más</a>
        </div>
      </div>
      {{/if}}
      {{#if textos.cardTitulo2}}
      <div class="card">
        {{#if textos.cardImage2}}<img src="{{textos.cardImage2}}" class="card-img-top" alt="{{textos.cardTitulo2}}"{{#if textos.cardImage2Pos}} style="object-position: center {{textos.cardImage2Pos}}%"{{/if}}>{{/if}}
        <div class="card-body pb-2">
          <h5 class="card-title">{{textos.cardTitulo2}}</h5>
          <p>
            {{textos.cardTexto2}}
          </p>
        </div>
        <div class="card-footer text-center border-0 bg-transparent pt-0">
          <a href="#" class="btn btn-dark" hidden>Ver más</a>
        </div>
      </div>
      {{/if}}
      {{#if textos.cardTitulo3}}
      <div class="card">
        {{#if textos.cardImage3}}<img src="{{textos.cardImage3}}" class="card-img-top" alt="{{textos.cardTitulo3}}"{{#if textos.cardImage3Pos}} style="object-position: center {{textos.cardImage3Pos}}%"{{/if}}>{{/if}}
        <div class="card-body pb-2">
          <h5 class="card-title">{{textos.cardTitulo3}}</h5>
          <p>
            {{textos.cardTexto3}}
          </p>
        </div>
        <div class="card-footer text-center border-0 bg-transparent pt-0">
          <a href="#" class="btn btn-dark" hidden>Ver más</a>
        </div>
      </div>
      {{/if}}
      {{#if textos.cardTitulo4}}
      <div class="card">
        {{#if textos.cardImage4}}<img src="{{textos.cardImage4}}" class="card-img-top" alt="{{textos.cardTitulo4}}"{{#if textos.cardImage4Pos}} style="object-position: center {{textos.cardImage4Pos}}%"{{/if}}>{{/if}}
        <div class="card-body pb-2">
          <h5 class="card-title">{{textos.cardTitulo4}}</h5>
          <p>
            {{textos.cardTexto4}}
          </p>
        </div>
        <div class="card-footer text-center border-0 bg-transparent pt-0">
          <a href="#" class="btn btn-dark" hidden>Ver más</a>
        </div>
      </div>
      {{/if}}
    </div>
  </div>
</section>

{{!-- A.12 — Bloque de cierre, debajo de "Actividades".
      Se usa un campo NUEVO (`cierre`) a propósito: ningún documento de `pages` lo tiene hoy
      (verificado 21/09/2026 contra la base), así que este bloque sólo aparece en las páginas
      donde se cargue y NO cambia nada en /deutsch, /english, /musica, /educacionfisica ni
      /veronica. Se descartó reutilizar `parrafo4` justamente por eso: /orientacion, /deutsch,
      /secundaria y /primaria ya lo tienen cargado y les habría aparecido un párrafo nuevo. --}}
{{#if textos.cierre}}
<section>
  <div class="contenedor">
    <p>{{{textos.cierre}}}</p>
  </div>
</section>
{{/if}}

<section class="d-none">
  <div id="carrusel" class="p-0 m-0 pb-3">
    <div><img src="#" alt="imagen de inglés"></div>
  </div>
</section>