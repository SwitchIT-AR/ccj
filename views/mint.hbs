<section id="landing">
  <div class="landing-img"
    style="background-image: linear-gradient(rgba(0,0,0,.15), rgba(0,0,0,.15)),url({{#if textos.imageTop}}{{textos.imageTop}}{{else}}/img/mint/mintBanner.jpg{{/if}});">
    <h2 style="margin-top: -240px;">{{textos.titulo}}</h2>
  </div>
</section>

<section>
  <div class="contenedor">
    <img class="img-nivel mt-n4" src="/img/iconos/iconos-15.png" alt="">
    <p>{{textos.parrafo1}}</p>
    <br />
    <p>{{textos.parrafo2}}</p>
    <p>
      <br />
      {{textos.parrafo3}}
    </p>

    {{!-- A.10 — Botón al blog de MINT (Blogger, mint.colegiociudadjardin.edu.ar: es el mismo
          destino que ya usan las tarjetas de actividades de abajo). Debajo de la descripción,
          en el apartado blanco, como pidió el colegio. --}}
    <div class="text-center mt-5">
      <a class="btn btn-lg px-5 py-3 font-weight-bold text-white"
         style="background-color: #009540; border-radius: 30px; letter-spacing: 1px;"
         href="https://mint.colegiociudadjardin.edu.ar/?view=magazine" target="_blank" rel="noopener">VER TODAS LAS ACTIVIDADES</a>
    </div>
  </div>
</section>

<section>
  <div class="contenedor" style="background-color: #F8CC3D;">
    <h5 style="font-weight: 600;">{{textos.parrafo4}}</h5>
  </div>
</section>

<section id="title-cards" class="c-rojo">
  <div class="mx-4 p-5">
    <h2 class="text-center mb-5">{{textos.subTitulo1}}</h2>
    <div class="card-deck card-deck-primaria mb-5">
      {{!-- Las cuatro tarjetas llevan al blog de MINT. La foto se muestra sólo si el documento la trae. --}}
      <div class="card">
        <a href="https://mint.colegiociudadjardin.edu.ar/?view=magazine" style="text-decoration: none;">
          {{#if textos.cardImage1}}<img src="{{textos.cardImage1}}" class="card-img-top" alt="{{textos.cardTitulo1}}">{{/if}}
          <div class="card-body">
            <h5 class="card-title" style="color:black;text-decoration: none;">{{textos.cardTitulo1}}</h5>
          </div>
        </a>
      </div>
      <div class="card">
        <a href="https://mint.colegiociudadjardin.edu.ar/?view=magazine" style="text-decoration: none;">
          {{#if textos.cardImage2}}<img src="{{textos.cardImage2}}" class="card-img-top" alt="{{textos.cardTitulo2}}">{{/if}}
          <div class="card-body">
            <h5 class="card-title" style="color:black;text-decoration: none;">{{textos.cardTitulo2}}</h5>
          </div>
        </a>
      </div>
      <div class="card">
        <a href="https://mint.colegiociudadjardin.edu.ar/?view=magazine" style="text-decoration: none;">
          {{#if textos.cardImage3}}<img src="{{textos.cardImage3}}" class="card-img-top" alt="{{textos.cardTitulo3}}">{{/if}}
          <div class="card-body">
            <h5 class="card-title" style="color:black;text-decoration: none;">{{textos.cardTitulo3}}</h5>
          </div>
        </a>
      </div>
      <div class="card">
        <a href="https://mint.colegiociudadjardin.edu.ar/?view=magazine" style="text-decoration: none;">
          {{#if textos.cardImage4}}<img src="{{textos.cardImage4}}" class="card-img-top" alt="{{textos.cardTitulo4}}">{{/if}}
          <div class="card-body">
            <h5 class="card-title" style="color:black;text-decoration: none;">{{textos.cardTitulo4}}</h5>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="c-celeste text-white" id="data">
  <div class="contenedor">
    <h2>{{textos.subTitulo2}}</h2>
    <p>{{textos.parrafo5}}</p>
    <div class="row eoe">
      <div class="col-sm-3 d-flex justify-content-center align-items-center">
        {{#if textos.equipoImage1}}<img class="img-nivel" src="{{textos.equipoImage1}}" alt="">{{/if}}
      </div>
      <div class="col-sm-9 h-100 m-auto">
        <p>{{textos.equipoTexto1}}</p>
      </div>
    </div>
    <div class="row eoe">
      <div class="col-sm-3 d-flex justify-content-center align-items-center">
        {{#if textos.equipoImage2}}<img class="img-nivel" src="{{textos.equipoImage2}}" alt="">{{/if}}
      </div>
      <div class="col-sm-9 h-100 m-auto">
        <p>{{textos.equipoTexto2}}</p>
      </div>
    </div>
    <div class="row eoe">
      <div class="col-sm-3 d-flex justify-content-center align-items-center">
        {{#if textos.equipoImage3}}<img class="img-nivel img-perfil-circular" src="{{textos.equipoImage3}}" alt="">{{/if}}
      </div>
      <div class="col-sm-9 h-100 m-auto">
        <p>{{textos.equipoTexto3}}</p>
      </div>
    </div>
    <p>{{textos.gestion}}</p>
    <ul>
      {{#each (lineas textos.gestionLista)}}
      <li>
        <p>{{this}}</p>
      </li>
      {{/each}}
    </ul>
    <br />
    <h5>{{textos.apoyo}}</h5>
  </div>
</section>

{{#if textos.tablaImage}}
<section id="title-cards" class="c-rojo">
  <div class="mx-5 p-5" style="text-align: center;">
    <img src="{{textos.tablaImage}}" alt="" style="width: 80vw; border-radius:10px; " />
  </div>
</section>
{{/if}}

<section id="title-cards" class="c-amarillo">
  <div class="mx-5 p-5">
    <h3>{{textos.subTitulo3}}</h3>
    <div>
      {{#each (entradas textos.calendario)}}
      <h5>{{#if titulo}}<strong>{{titulo}}:</strong>{{/if}} {{texto}}</h5><br />
      {{/each}}
    </div>
  </div>
</section>
