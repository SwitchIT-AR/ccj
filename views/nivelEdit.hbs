<div class="container-fluid" style=" background-color:rgb(198, 198, 198);">
    <div class="container" style=" padding-top: 100px; background-color: white;">
        <h1>Niveles Update</h1>
        <span>Seleccione la pagina a editar</span>
        <br />
        <select id="page" class="form-control-sm" onchange="redirectToSelectedOption()">
            <option value="">Seleccione una pagina</option>

            <option value="inicial">inicial</option>
            <option value="primaria">primaria</option>
            <option value="secundaria">secundaria</option>
        </select>
        <label for="pagina">ID</label>
        <input type="text" class="form-control" name="_id" value="{{pages._id}}" disabled><br>

        <label for="pagina">Pagina:</label>
        <input type="text" class="form-control" value="{{pages.ruta}}" disabled><br>

    </div>




    <form action="/pagesEdit/nivel/pagesUpdate" method="post" enctype="multipart/form-data">
