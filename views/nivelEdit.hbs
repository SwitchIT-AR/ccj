                                <label for="cardTexto4">Card Texto 4:</label>
                                <input type="text" class="form-control" name="cardTexto4"
                                    value="{{pages.cardTexto4}}"><br>
                            </div>
                            <div class="card-footer text-center border-0 bg-transparent pt-0">
                                <a href="#" class="btn btn-dark" hidden>Ver más</a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="c-rojo text-white text-center" id="horarios">
                <div class="contenedor">
                    <input type="text" class="form-control" name="subTitulo5" value="{{pages.subTitulo5}}"><br>
                    <input type="text" class="form-control" name="parrafo5" value="{{pages.parrafo5}}"><br>
                </div>
            </section>

            <section id="title-cards" class="c-violeta">
                <div class="mx-4 p-5">

                    <label for="horarioEntrada">Horario de Entrada:</label>
                    <input type="text" class="form-control" name="horarioEntrada" value="{{pages.horarioEntrada}}"><br>

                    <label for="almuerzo">Almuerzo:</label>
