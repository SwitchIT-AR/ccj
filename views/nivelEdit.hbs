                    <label for="almuerzo">Salida:</label>
                    <input type="text" class="form-control" name="horarioSalida" value="{{pages.horarioSalida}}"><br>



            </section>
            <br />
            <input class="btn btn-primary btn-lg btn-block" type="submit" value="Guardar">
            <br />
        </div>
    </form>
</div>
<script>
// Encuadre vertical de la portada y de las fotos de las tarjetas. El slider mueve la vista previa
// en vivo y sólo se envía (tiene `name`) si se lo toca: así guardar otra cosa no pisa el encuadre.
(function () {
  function y(el, prop) {
    var v = getComputedStyle(el)[prop] || "";
    var n = parseFloat(v.split(" ").pop());
    return isNaN(n) ? 50 : Math.round(n);
  }
  document.querySelectorAll(".encuadre input[type=range]").forEach(function (slider) {
    var hero = slider.closest(".landing-img");
    var target = hero || slider.closest(".card").querySelector("img");
    var out = slider.parentNode.querySelector(".encuadre-valor");
    var saved = parseFloat(slider.getAttribute("data-saved"));
    var start = isNaN(saved) ? y(target, hero ? "backgroundPositionY" : "objectPosition") : saved;
    slider.value = start;
    out.textContent = start;
    slider.addEventListener("input", function () {
      slider.name = slider.getAttribute("data-name");
      out.textContent = slider.value;
      if (hero) target.style.backgroundPosition = "center " + slider.value + "%";
      else target.style.objectPosition = "center " + slider.value + "%";
    });
  });
})();
</script>
<script src="/dist/js/pages/nivelEdit.js">