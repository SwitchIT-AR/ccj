                            <input type="file" class="form-control" name="cardImage4" accept="image/*"><br>
                            <div class="encuadre my-2" style="background:rgba(255,255,255,.85);color:#000;padding:6px 10px;border-radius:8px">
                                <label class="mb-0">Encuadre de la foto: <b><span class="encuadre-valor"></span>%</b> <small>(0 = arriba, 100 = abajo)</small></label>
